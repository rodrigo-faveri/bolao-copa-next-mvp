# Producao
DATABASE_URL="postgresql://USER:SENHA_FORTE_COM_16+_CARACTERES@HOST:5432/DATABASE?schema=public"

AUTH_SECRET="gere-uma-secret-com-npx-auth-secret"
AUTH_GOOGLE_ID="google-client-id-de-producao"
AUTH_GOOGLE_SECRET="google-client-secret-de-producao"
AUTH_URL="https://seudominio.com"

ALLOW_UNSCHEDULED_PREDICTIONS="false"
ENFORCE_HTTPS="true"

# Recomendado em producao.
RATE_LIMIT_DRIVER="redis"
UPSTASH_REDIS_REST_URL="https://seu-redis.upstash.io"
UPSTASH_REDIS_REST_TOKEN="seu-token-upstash"

# Restrinja quem pode entrar.
ALLOWED_EMAILS="voce@email.com"
ALLOWED_EMAIL_DOMAINS=""
ADMIN_EMAILS="voce@email.com"

OPENROUTER_API_KEY=""
OPENROUTER_MODEL="nex-agi/nex-n2-pro:free"

SERPAPI_KEY=""
SERPAPI_RESULT_DELAY_MINUTES="130"
SERPAPI_RESULT_MAX_MATCHES="12"
SERPAPI_DRY_RUN="false"
SERPAPI_DEBUG="false"

API_FOOTBALL_KEY=""
API_FOOTBALL_BASE_URL="https://v3.football.api-sports.io"
SPORTS_API_CACHE_SECONDS="60"
