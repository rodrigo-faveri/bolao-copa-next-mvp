# Banco de dados
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public"

# Auth.js / Google OAuth
AUTH_SECRET="gere-com-npx-auth-secret"
AUTH_GOOGLE_ID="seu-google-client-id"
AUTH_GOOGLE_SECRET="seu-google-client-secret"
AUTH_URL="http://localhost:3000"

# Producao: deixe false. Em dev, true permite partidas sem horario definido para teste.
ALLOW_UNSCHEDULED_PREDICTIONS="false"
ENFORCE_HTTPS="true"

# Rate limit
# Use memory apenas em desenvolvimento ou instancia unica.
# Em producao com varias instancias, use redis.
RATE_LIMIT_DRIVER="memory"
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Opcional: restringe quem consegue entrar no bolao.
# Se ambos estiverem vazios, qualquer conta Google verificada consegue autenticar.
ALLOWED_EMAILS=""
ALLOWED_EMAIL_DOMAINS=""

# Admins separados por virgula. Ex.: "voce@email.com,outra@email.com"
ADMIN_EMAILS=""

# Opcional: ativa o assistente de IA via OpenRouter.
OPENROUTER_API_KEY=""
OPENROUTER_MODEL="nex-agi/nex-n2-pro:free"

# Opcional: sincroniza resultados pos-jogo via SerpAPI/Google Sports.
SERPAPI_KEY=""
SERPAPI_RESULT_DELAY_MINUTES="120"
SERPAPI_RESULT_MAX_MATCHES="12"
SERPAPI_DRY_RUN="false"
SERPAPI_DEBUG="false"

# Push notifications reais para avisos fora do navegador.
# Gere com: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:voce@email.com"
PUSH_REMINDER_WINDOW_MINUTES="60"

# Webhook opcional para monitoramento externo de erros.
MONITORING_WEBHOOK_URL=""

# Opcional/legado: integra placar e lances via API-Football quando houver fixture externo.
API_FOOTBALL_KEY=""
API_FOOTBALL_BASE_URL="https://v3.football.api-sports.io"
SPORTS_API_CACHE_SECONDS="60"
