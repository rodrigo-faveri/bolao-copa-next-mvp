# Banco de dados
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public"

# Auth.js / Google OAuth
AUTH_SECRET="gere-com-npx-auth-secret"
AUTH_GOOGLE_ID="seu-google-client-id"
AUTH_GOOGLE_SECRET="seu-google-client-secret"
AUTH_URL="http://localhost:3000"

# Produção: deixe false. Em dev, true permite partidas sem horário definido para teste.
ALLOW_UNSCHEDULED_PREDICTIONS="false"
ENFORCE_HTTPS="true"
RATE_LIMIT_DRIVER="memory"
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Opcional: restringe quem consegue entrar no bolão.
# Se ambos estiverem vazios, qualquer conta Google consegue autenticar.
ALLOWED_EMAILS=""
ALLOWED_EMAIL_DOMAINS=""

# Admins separados por vírgula. Ex.: "voce@email.com,outra@email.com"
ADMIN_EMAILS=""

# Opcional: ativa o assistente de IA via OpenRouter.
OPENROUTER_API_KEY=""
OPENROUTER_MODEL="nex-agi/nex-n2-pro:free"
