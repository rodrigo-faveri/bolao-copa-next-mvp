# Desenvolvimento local
DATABASE_URL="postgresql://postgres:SENHA_LOCAL@localhost:5432/palpites?schema=public"

AUTH_SECRET="gere-com-npx-auth-secret"
AUTH_GOOGLE_ID="seu-google-client-id-local"
AUTH_GOOGLE_SECRET="seu-google-client-secret-local"
AUTH_URL="http://localhost:3000"

# Em dev voce pode usar true para testar partidas sem horario cadastrado.
ALLOW_UNSCHEDULED_PREDICTIONS="true"
ENFORCE_HTTPS="false"

RATE_LIMIT_DRIVER="memory"
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Deixe vazio para facilitar testes locais, ou restrinja ao seu email.
ALLOWED_EMAILS=""
ALLOWED_EMAIL_DOMAINS=""
ADMIN_EMAILS="voce@email.com"

OPENROUTER_API_KEY=""
OPENROUTER_MODEL="nex-agi/nex-n2-pro:free"

SERPAPI_KEY=""
SERPAPI_RESULT_DELAY_MINUTES="120"
SERPAPI_RESULT_MAX_MATCHES="12"
SERPAPI_DRY_RUN="false"
SERPAPI_DEBUG="false"

VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:voce@email.com"
PUSH_REMINDER_WINDOW_MINUTES="60"

MONITORING_WEBHOOK_URL=""

API_FOOTBALL_KEY=""
API_FOOTBALL_BASE_URL="https://v3.football.api-sports.io"
SPORTS_API_CACHE_SECONDS="60"
