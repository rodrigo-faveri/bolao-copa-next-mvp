generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String       @id @default(cuid())
  name          String?
  nickname      String?
  avatarColor   String?
  email         String?      @unique
  emailVerified DateTime?
  image         String?
  accounts      Account[]
  sessions      Session[]
  predictions   Prediction[]
  pushSubscriptions PushSubscription[]
  pushNotificationLogs PushNotificationLog[]
  createdPools  Pool[]       @relation("PoolCreator")
  poolMemberships PoolMember[]
  createdAt     DateTime     @default(now())

  @@index([createdAt])
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique
  p256dh     String
  auth      String
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
}

model PushNotificationLog {
  id        String   @id @default(cuid())
  userId    String
  matchId   String
  kind      String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  match     Match    @relation(fields: [matchId], references: [id], onDelete: Cascade)

  @@unique([userId, matchId, kind])
  @@index([createdAt])
  @@index([matchId])
  @@index([userId])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Match {
  id                 String       @id @default(cuid())
  group              String
  teamA              String
  teamB              String
  probabilityTeamA   Float?
  probabilityDraw    Float?
  probabilityTeamB   Float?
  expectedGoals      Float?
  mostLikelyScore    String?
  topScores          String?
  startsAt           DateTime?
  status             String       @default("scheduled")
  liveUrl            String?
  resultGoalsA       Int?
  resultGoalsB       Int?
  finishedAt         DateTime?
  predictions        Prediction[]
  events             MatchEvent[]
  pushNotificationLogs PushNotificationLog[]

  @@unique([group, teamA, teamB])
  @@index([startsAt])
  @@index([status])
}

model MatchEvent {
  id          String   @id @default(cuid())
  matchId     String
  minute      String
  title       String
  description String
  createdAt   DateTime @default(now())
  match       Match    @relation(fields: [matchId], references: [id], onDelete: Cascade)

  @@index([matchId])
  @@index([createdAt])
}

model Prediction {
  id        String   @id @default(cuid())
  userId    String
  matchId   String
  goalsA    Int
  goalsB    Int
  points    Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  match     Match    @relation(fields: [matchId], references: [id], onDelete: Cascade)

  @@unique([userId, matchId])
  @@index([userId])
  @@index([matchId])
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  actorEmail String?
  action     String
  entity     String?
  entityId   String?
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([action])
  @@index([entity, entityId])
  @@index([createdAt])
}

model ResultSyncRun {
  id           String    @id @default(cuid())
  provider     String
  status       String
  imported     Int       @default(0)
  skipped      Int       @default(0)
  candidates   Int       @default(0)
  errorMessage String?
  startedAt    DateTime  @default(now())
  finishedAt   DateTime?

  @@index([provider])
  @@index([status])
  @@index([startedAt])
}

model Pool {
  id          String       @id @default(cuid())
  name        String
  inviteCode  String       @unique
  exactScorePoints Int      @default(5)
  outcomePoints    Int      @default(3)
  mode        String       @default("friends")
  createdById String?
  createdBy   User?        @relation("PoolCreator", fields: [createdById], references: [id], onDelete: SetNull)
  members     PoolMember[]
  createdAt   DateTime     @default(now())

  @@index([createdById])
  @@index([createdAt])
}

model PoolMember {
  id       String   @id @default(cuid())
  poolId   String
  userId   String
  role     String   @default("member")
  joinedAt DateTime @default(now())
  pool     Pool     @relation(fields: [poolId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([poolId, userId])
  @@index([userId])
  @@index([poolId])
}
