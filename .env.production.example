ALLOW_UNSCHEDULED_PREDICTIONS="false"
ENFORCE_HTTPS="true"

# Recomendado em producao.
RATE_LIMIT_DRIVER="redis"
UPSTASH_REDIS_REST_URL="https://seu-redis.upstash.io"
UPSTASH_REDIS_REST_TOKEN="seu-token-upstash"

# Restrinja quem pode entrar.
