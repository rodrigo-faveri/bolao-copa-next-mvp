generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String       @id @default(cuid())
  name          String?
  nickname      String?
  avatarColor   String?
  email         String?      @unique
  emailVerified DateTime?
  image         String?
  accounts      Account[]
  sessions      Session[]
  predictions   Prediction[]
  knockoutPredictions KnockoutPrediction[]
  pushSubscriptions PushSubscription[]
  pushNotificationLogs PushNotificationLog[]
  matchAlerts UserMatchAlert[]
  notifyPickDeadlines Boolean @default(true)
  notifyResults Boolean @default(true)
  notifyRoundSummary Boolean @default(true)
  notificationLeadMinutes Int @default(60)
  createdPools  Pool[]       @relation("PoolCreator")
  poolMemberships PoolMember[]
  createdAt     DateTime     @default(now())

  @@index([createdAt])
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique
  p256dh     String
  auth      String
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
}

model PushNotificationLog {
  id        String   @id @default(cuid())
  userId    String
  matchId   String
  kind      String
  title     String?
  body      String?
  url       String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  match     Match    @relation(fields: [matchId], references: [id], onDelete: Cascade)

  @@unique([userId, matchId, kind])
  @@index([createdAt])
  @@index([matchId])
  @@index([userId])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Match {
  id                 String       @id @default(cuid())
  group              String
  teamA              String
  teamB              String
  probabilityTeamA   Float?
  probabilityDraw    Float?
  probabilityTeamB   Float?
  expectedGoals      Float?
  mostLikelyScore    String?
  topScores          String?
  startsAt           DateTime?
  status             String       @default("scheduled")
  liveUrl            String?
  externalFixtureId  Int?
  resultGoalsA       Int?
  resultGoalsB       Int?
  winnerTeam         String?
  finishedAt         DateTime?
  predictions        Prediction[]
  events             MatchEvent[]
  pushNotificationLogs PushNotificationLog[]
  userMatchAlerts    UserMatchAlert[]

  @@unique([group, teamA, teamB])
  @@index([startsAt])
  @@index([status])
  @@index([externalFixtureId])
  @@index([winnerTeam])
}

model UserMatchAlert {
  id          String   @id @default(cuid())
  userId      String
  matchId     String
  kind        String   @default("pick_deadline")
  leadMinutes Int
  note        String?
  source      String   @default("assistant")
  enabled     Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  match       Match    @relation(fields: [matchId], references: [id], onDelete: Cascade)

  @@unique([userId, matchId, kind])
  @@index([matchId])
  @@index([userId])
  @@index([enabled])
}

model MatchEvent {
  id          String   @id @default(cuid())
  matchId     String
  minute      String
  title       String
  description String
  createdAt   DateTime @default(now())
  match       Match    @relation(fields: [matchId], references: [id], onDelete: Cascade)

  @@index([matchId])
  @@index([createdAt])
}

model Prediction {
  id        String   @id @default(cuid())
  userId    String
  matchId   String
  goalsA    Int
  goalsB    Int
  points    Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  match     Match    @relation(fields: [matchId], references: [id], onDelete: Cascade)

  @@unique([userId, matchId])
  @@index([userId])
  @@index([matchId])
}

model KnockoutPrediction {
  id             String   @id @default(cuid())
  userId         String
  poolId         String?
  poolScope      String   @default("global")
  bracketRound   String
  bracketMatchId String
    homeLabel      String
    awayLabel      String
    homeTeam       String?
    awayTeam       String?
    homeGoals      Int?
    awayGoals      Int?
    winnerTeam     String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  pool           Pool?    @relation(fields: [poolId], references: [id], onDelete: Cascade)

  @@unique([userId, poolScope, bracketMatchId])
  @@index([userId])
  @@index([poolId])
  @@index([poolScope])
  @@index([bracketRound])
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  actorEmail String?
  action     String
  entity     String?
  entityId   String?
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([action])
  @@index([entity, entityId])
  @@index([createdAt])
}

model ResultSyncRun {
  id           String    @id @default(cuid())
  provider     String
  status       String
  imported     Int       @default(0)
  skipped      Int       @default(0)
  candidates   Int       @default(0)
  errorMessage String?
  startedAt    DateTime  @default(now())
  finishedAt   DateTime?

  @@index([provider])
  @@index([status])
  @@index([startedAt])
}

model ScheduledJobRun {
  id           String    @id @default(cuid())
  jobName      String
  status       String
  details      Json?
  errorMessage String?
  startedAt    DateTime  @default(now())
  finishedAt   DateTime?

  @@index([jobName])
  @@index([status])
  @@index([startedAt])
}

model KnowledgeDocument {
  id          String   @id @default(cuid())
  source      String
  sourceId    String
  title       String
  content     String   @db.Text
  url         String?
  metadata    Json?
  embedding   Json?
  contentHash String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([source, sourceId])
  @@index([source])
  @@index([updatedAt])
}

model AiEvaluationRun {
  id                String   @id @default(cuid())
  averageScore      Float
  totalCases        Int
  passedCases       Int
  failedCases       Int
  gitCommit         String?
  gitBranch         String?
  embeddingsEnabled Boolean  @default(false)
  webSearchEnabled  Boolean  @default(false)
  createdAt         DateTime @default(now())
  caseResults       AiEvaluationCaseResult[]

  @@index([createdAt])
  @@index([gitCommit])
}

model AiEvaluationCaseResult {
  id             String          @id @default(cuid())
  runId          String
  caseId         String
  question       String          @db.Text
  score          Int
  passed         Boolean
  minimumScore   Int
  missingTerms   Json?
  missingSources Json?
  notes          Json?
  createdAt      DateTime        @default(now())
  run            AiEvaluationRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([runId])
  @@index([caseId])
  @@index([passed])
}

model Pool {
  id          String       @id @default(cuid())
  name        String
  inviteCode  String       @unique
  exactScorePoints Int      @default(5)
  outcomePoints    Int      @default(3)
  groupStageExactScorePoints Int @default(5)
  groupStageOutcomePoints    Int @default(3)
  knockoutExactScorePoints   Int @default(8)
  knockoutOutcomePoints      Int @default(4)
  mode        String       @default("friends")
  createdById String?
  createdBy   User?        @relation("PoolCreator", fields: [createdById], references: [id], onDelete: SetNull)
  members     PoolMember[]
  knockoutPredictions KnockoutPrediction[]
  createdAt   DateTime     @default(now())

  @@index([createdById])
  @@index([createdAt])
}

model PoolMember {
  id       String   @id @default(cuid())
  poolId   String
  userId   String
  role     String   @default("member")
  joinedAt DateTime @default(now())
  pool     Pool     @relation(fields: [poolId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([poolId, userId])
  @@index([userId])
  @@index([poolId])
}
